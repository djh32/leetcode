'''
问题：给定一个未排序的数组，排序使得数组满足如下要求：排序后的数组呈【小，大，小，大，小，大••］的形式。如给定［2，1,3，4］，排序后为【1,3,2,4］。返回任意一组满足要求的排序后数组即可。假设无重复数字。
'''


def xiaoda(nums):
    # 不能有重复 直接sort 后从index=1开始换(1,2)  (3,4)
    st_nums = sorted(nums)
    for i in range(1, len(st_nums), 2):
        if i + 1 >= len(st_nums): return st_nums
        st_nums[i], st_nums[i + 1] = st_nums[i + 1], st_nums[i]
    return st_nums


def daxiao(nums):
    st_nums = sorted(nums)
    for i in range(1, len(st_nums), 2):
        st_nums[i], st_nums[i - 1] = st_nums[i - 1], st_nums[i]
    return st_nums


def xiaoda_multi_value(nums):
    # 可以有重复 双指针
    st_nums = sorted(nums)
    l, r = 0, len(st_nums) - 1
    res = [0] * len(st_nums)
    i = 0
    while l <= r:
        res[i] = st_nums[l]
        l += 1
        i += 1
        if l > r: return res  # 注意奇数个num的结果
        res[i] = st_nums[r]
        r -= 1
        i += 1
    return res


print(xiaoda([1, 2, 3, 4]))
print(daxiao([1, 2, 3, 4, 5, 6, 7]))
print(xiaoda_multi_value([2, 2, 3, 3]))
